<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The estimation core (ADR 0005, port stage 1): the quote calculation, the carrier calls, Plant Charges and the
    Quote logging, with no System.Web in it, so it compiles for the Framework the app runs on today and for .NET 8.
    Namespaces are unchanged (AuthenticationServer.*), so the web project and the tests need no code change for the move.
  -->
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AuthenticationServer</RootNamespace>
    <AssemblyName>AuthenticationServer.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Generated, so the InternalsVisibleTo items below are emitted. Version stays 1.0.0.0 like the web project. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- Same version as the web project's packages.config, so the runtime loads the assembly the app already ships. -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FreightEstimator.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>FreightEstimator.QuoteTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
