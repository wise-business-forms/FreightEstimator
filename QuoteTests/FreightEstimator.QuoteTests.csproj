<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Characterization tests for the Plant page's quote flow (#15). Runs on .NET Framework because
    PlantController is an ASP.NET MVC 5 controller, which cannot load on net8.0 (the Tests project).
    Needs a SANDBOX UpsRate database: see ConnectionStrings.Sandbox.config.example. Build the web
    project first (Visual Studio MSBuild); see docs/agents/ for the test commands.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FreightEstimator.QuoteTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Same versions as the web project's packages.config, so the runtime loads the assemblies it was built against. -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.0" />
    <PackageReference Include="System.Memory" Version="4.6.0" />
    <PackageReference Include="System.Buffers" Version="4.6.0" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.0" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
    <PackageReference Include="System.Text.Encodings.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreightEstimator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same fake the net8 tests use. -->
    <Compile Include="..\Tests\Fakes\FakeCarrierHttp.cs" Link="Fakes\FakeCarrierHttp.cs" />
    <None Include="..\Tests\Recorded\**" Link="Recorded\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Recorded\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Connection strings: SANDBOX only. The test refuses to run if they point anywhere else. -->
    <None Include="..\ConnectionStrings.Sandbox.config" Link="ConnectionStrings.Sandbox.config" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\ConnectionStrings.Sandbox.config')" />
  </ItemGroup>

</Project>
