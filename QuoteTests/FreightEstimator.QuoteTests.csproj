<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Characterization tests for the Plant page's quote flow (#15) and the Quote API (#18), run against the ASP.NET Core
    app (FreightEstimator.Web, .NET 8). Needs a SANDBOX UpsRate database: see ConnectionStrings.Sandbox.config.example.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FreightEstimator.QuoteTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreightEstimator.Web\FreightEstimator.Web.csproj" />
    <!-- The test host on .NET reads testhost.dll.config, not the test assembly's own, so the connection strings need to be there. -->
    <None Include="app.config" Link="testhost.dll.config" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <!-- Hosts the ASP.NET Core app in memory, to prove it starts, routes, serves its assets and renders the Plant page. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same fake the net8 tests use. -->
    <Compile Include="..\Tests\Fakes\FakeCarrierHttp.cs" Link="Fakes\FakeCarrierHttp.cs" />
    <None Include="..\Tests\Recorded\**" Link="Recorded\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Recorded\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Connection strings: SANDBOX only. The test refuses to run if they point anywhere else. -->
    <None Include="..\ConnectionStrings.Sandbox.config" Link="ConnectionStrings.Sandbox.config" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\ConnectionStrings.Sandbox.config')" />
  </ItemGroup>

</Project>
