<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The ASP.NET Core web app (ADR 0005, port stages 2 and 3; #29, #30): the Plant page, the plant picker, Reports and the
    Quote API, hosted by IIS (in-process, via the ASP.NET Core Module; the app is never self-hosted on Kestrel). It replaced
    the .NET Framework (System.Web) host. The estimation core is the FreightEstimator.Core assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AuthenticationServer</RootNamespace>
    <AssemblyName>FreightEstimator.Web</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreightEstimator.Core\FreightEstimator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FreightEstimator.QuoteTests" />
  </ItemGroup>

</Project>
