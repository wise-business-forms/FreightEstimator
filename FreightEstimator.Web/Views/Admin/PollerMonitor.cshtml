@{
    ViewBag.Title = "Poller Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;" id="monitor" data-status-url="@Url.Action("PollerMonitorStatus", "Admin")">
    <div class="clearfix">
        <h2 class="pull-left" style="margin-top: 0;">Poller Monitor</h2>
        <div class="pull-right text-muted" style="margin-top: 6px;">
            <span id="updated">Waiting for the first reading...</span>
            <button type="button" id="pause" class="btn btn-default btn-xs" style="margin-left: 8px;">Pause</button>
        </div>
    </div>
    <hr />

    <div id="health" class="alert alert-info">Waiting for the first reading...</div>
    <div id="errors"></div>

    <h4>Instances</h4>
    <p class="text-muted small">Every CostPlus Poller process that has reported in the last hour. One that has not written a heartbeat for 30 s is shown as stopped.</p>
    <table class="table table-condensed" id="instances">
        <thead>
            <tr><th>Instance</th><th>Stage</th><th>State</th><th>Last heartbeat</th><th>Last successful poll</th><th>Up for</th><th>Idle polls</th><th>Requests handled</th><th>Dropped events</th></tr>
        </thead>
        <tbody></tbody>
    </table>

    <h4>Stall monitor and probe</h4>
    <ul class="list-unstyled" id="services">
        <li id="stall-line" class="text-muted">...</li>
        <li id="probe-line" class="text-muted">...</li>
    </ul>

    <h4>Waiting queue</h4>
    <p class="text-muted small">Requests no poller has claimed or answered (UPS only; the console app keeps every request that asks for LTL). Street addresses are never shown.</p>
    <p><strong id="waiting-count">...</strong></p>
    <h5>Oldest waiting</h5>
    <table class="table table-condensed" id="oldest">
        <thead><tr><th>Request</th><th>From</th><th>To zip</th><th>Carriers</th><th>Waiting</th></tr></thead>
        <tbody></tbody>
    </table>
    <h5>In flight</h5>
    <table class="table table-condensed" id="inflight">
        <thead><tr><th>Request</th><th>From</th><th>To zip</th><th>Carriers</th><th>Claimed by</th><th>Waiting</th></tr></thead>
        <tbody></tbody>
    </table>
</div>

<script>
(function () {
    var root = document.getElementById('monitor');
    var url = root.getAttribute('data-status-url');
    var paused = false;
    var pauseButton = document.getElementById('pause');

    // Everything from the server is put on the page as text, never as markup: a LoginId is whatever CostPlus sent.
    function text(value) { return value === null || value === undefined || value === '' ? '-' : String(value); }

    function ago(seconds) {
        if (seconds === null || seconds === undefined) return 'never';
        if (seconds < 90) return Math.round(seconds) + ' s ago';
        if (seconds < 5400) return Math.round(seconds / 60) + ' min ago';
        return (seconds / 3600).toFixed(1) + ' h ago';
    }

    function span(seconds) {
        if (seconds === null || seconds === undefined) return '-';
        if (seconds < 90) return Math.round(seconds) + ' s';
        if (seconds < 5400) return Math.round(seconds / 60) + ' min';
        return (seconds / 3600).toFixed(1) + ' h';
    }

    function fill(tableId, rows, emptyText, columns) {
        var body = document.querySelector('#' + tableId + ' tbody');
        body.textContent = '';
        if (rows.length === 0) {
            var tr = document.createElement('tr'), td = document.createElement('td');
            td.colSpan = columns; td.className = 'text-muted'; td.textContent = emptyText;
            tr.appendChild(td); body.appendChild(tr);
            return;
        }
        rows.forEach(function (cells) {
            var tr = document.createElement('tr');
            cells.forEach(function (cell) {
                var td = document.createElement('td');
                td.textContent = cell;
                tr.appendChild(td);
            });
            body.appendChild(tr);
        });
    }

    function carriers(q) { return (q.ups ? 'UPS ' : '') + (q.ltl ? 'LTL' : '') || '-'; }
    function request(q) { return text(q.loginId) + ' #' + q.qtyNumber + (q.isProbe ? ' (probe)' : ''); }

    function show(s) {
        var health = document.getElementById('health');
        if (s.healthy === null) {
            health.className = 'alert alert-warning';
            health.textContent = 'The poller status could not be read.';
        } else if (s.healthy) {
            health.className = 'alert alert-success';
            health.textContent = 'Healthy: ' + s.instances.filter(function (i) { return i.running; }).length + ' poller instance(s) running.';
        } else {
            health.className = 'alert alert-danger';
            health.textContent = s.problems.join(' ');
        }

        var errors = document.getElementById('errors');
        errors.textContent = '';
        s.errors.forEach(function (e) {
            var d = document.createElement('div'); d.className = 'alert alert-warning'; d.textContent = e; errors.appendChild(d);
        });

        fill('instances', s.instances.map(function (i) {
            return [i.instanceId, i.mode, i.running ? 'Running' : 'Stopped', ago(i.heartbeatAgeSeconds), ago(i.lastPollAgeSeconds),
                    span(i.startedAgoSeconds), i.idlePolls, i.requestsHandled, i.droppedEvents];
        }), 'No poller instance has reported in the last hour.', 9);

        document.getElementById('stall-line').textContent =
            'Stall monitor: last email sent (a stall, a reminder or a recovery) ' + (s.stallMonitor.lastAlertSentAgoSeconds === null ? 'never (since the instances started)' : ago(s.stallMonitor.lastAlertSentAgoSeconds)) + '.';
        var probe = s.probe.latest;
        document.getElementById('probe-line').textContent =
            'Probe: last request sent ' + (s.probe.lastInsertedAgoSeconds === null ? 'never (since the instances started; it only runs in the Live stage, in quiet hours)' : ago(s.probe.lastInsertedAgoSeconds)) +
            (probe ? '; the latest probe in the table was made ' + ago(probe.sentAgeSeconds) + ' and ' + (probe.answered ? 'has been answered' : 'has not been answered') : '') + '.';

        if (s.queue) {
            document.getElementById('waiting-count').textContent = s.queue.waiting + ' waiting';
            fill('oldest', s.queue.oldest.map(function (q) { return [request(q), text(q.fromState), text(q.toZip), carriers(q), span(q.ageSeconds)]; }), 'Nothing is waiting.', 5);
            fill('inflight', s.queue.inFlight.map(function (q) { return [request(q), text(q.fromState), text(q.toZip), carriers(q), text(q.claimedBy), span(q.ageSeconds)]; }), 'Nothing is in flight.', 6);
        } else {
            document.getElementById('waiting-count').textContent = 'The queue could not be read.';
        }
        document.getElementById('updated').textContent = 'Updated ' + new Date().toLocaleTimeString();
    }

    function refresh() {
        if (paused) return;
        fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin', cache: 'no-store' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(show)
            .catch(function (e) { document.getElementById('updated').textContent = 'Could not refresh (' + e.message + '); trying again...'; });
    }

    pauseButton.addEventListener('click', function () {
        paused = !paused;
        pauseButton.textContent = paused ? 'Resume' : 'Pause';
        if (!paused) refresh();
    });

    refresh();
    setInterval(refresh, 2000);
})();
</script>
