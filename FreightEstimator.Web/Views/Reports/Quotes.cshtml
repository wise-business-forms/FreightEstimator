@model List<AuthenticationServer.Models.RateRequestRecord>

@{
    ViewBag.Title = "Past Plantrol Quotes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    int totalCount = ViewBag.TotalCount;
    int pageSize = ViewBag.PageSize;
    string selectedPlant = ViewBag.SelectedPlant;
    string searchTerm = ViewBag.SearchTerm;
    var plants = (List<AuthenticationServer.Models.Plant>)ViewBag.Plants;
    bool noSelection = string.IsNullOrEmpty(selectedPlant) && string.IsNullOrWhiteSpace(searchTerm);
    var compareIds = ViewBag.CompareIds as HashSet<int> ?? new HashSet<int>();
}

<style>
    .quotes-table th {
        background-color: #9ec5fe;
        white-space: nowrap;
    }
    .detail-row td {
        background-color: #f8f9fa;
        padding: 8px 16px;
    }
    .services-table th {
        background-color: #d1e7dd;
    }
    .toggle-btn {
        width: 28px;
        cursor: pointer;
    }
</style>

<div class="container-fluid" style="margin-top: 20px;">
    <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 10px;">
        <h2 style="margin: 0;">Past Quotes</h2>
        @if (!noSelection)
        {
            <span class="text-muted">@totalCount total records &mdash; showing page @(page) of @totalPages</span>
        }
        <a href="@Url.Action("Index", "Reports")" class="btn btn-sm btn-outline-secondary" style="margin-left: auto;">&#8592; Reports</a>
    </div>
    <hr style="margin-top: 6px;" />

    <div class="row" style="margin-bottom: 16px;">
        <div class="col-md-6">
            <form method="get" action="@Url.Action("Quotes", "Reports")" class="form-inline quotes-form">
                <div class="input-group" style="width: 100%;">
                    <input type="text" 
                           name="search" 
                           class="form-control" 
                           placeholder="Search by quote number..." 
                           value="@ViewBag.SearchTerm"
                           style="flex: 1;" />
                    <input type="hidden" name="plant" value="@selectedPlant" />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-primary">Search</button>
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                        {
                            <a href="@Url.Action("Quotes", "Reports", new { plant = selectedPlant })" class="btn btn-secondary">Clear</a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div style="display: flex; align-items: flex-start; gap: 16px; margin-bottom: 16px;">
        <form method="get" action="@Url.Action("Quotes", "Reports")" class="form-inline quotes-form">
            <input type="hidden" name="search" value="@searchTerm" />
            <label for="plant-filter" style="margin-right: 8px;">Plant</label>
            <select id="plant-filter" name="plant" class="form-control">
                <option value="" selected="@(string.IsNullOrEmpty(selectedPlant))"></option>
                <option value="@AuthenticationServer.Controllers.ReportsController.AllPlants" selected="@(selectedPlant == AuthenticationServer.Controllers.ReportsController.AllPlants)">All plants</option>
                @foreach (var p in plants)
                {
                    <option value="@p.Id" selected="@(string.Equals(p.Id, selectedPlant, StringComparison.OrdinalIgnoreCase))">@p.Id &ndash; @p.Name</option>
                }
            </select>
            <span id="quotes-loading" class="text-muted" style="display: none; margin-left: 12px;">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                Loading quotes&hellip;
            </span>
        </form>
        @if (totalPages > 1)
        {
            <nav>
                <ul class="pagination" style="margin: 0;">
                    @if (page > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Quotes", "Reports", new { page = page - 1, pageSize = pageSize, search = searchTerm, plant = selectedPlant })">&laquo; Prev</a>
                        </li>
                    }
                    @for (int i = Math.Max(1, page - 4); i <= Math.Min(totalPages, page + 4); i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Quotes", "Reports", new { page = i, pageSize = pageSize, search = searchTerm, plant = selectedPlant })">@i</a>
                        </li>
                    }
                    @if (page < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Quotes", "Reports", new { page = page + 1, pageSize = pageSize, search = searchTerm, plant = selectedPlant })">Next &raquo;</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
    @if (noSelection)
    {
        <p class="text-muted">Select a plant to view quotes.</p>
    }
    <table class="table table-bordered table-hover table-sm quotes-table">
        <thead>
            <tr>
                <th class="toggle-btn"></th>
                <th>#</th>
                <th>Date</th>
                <th>User</th>
                <th>Address</th>
                <th>City</th>
                <th>State</th>
                <th>Zip</th>
                <th>Country</th>
                <th>Services</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model)
            {
                if (record.ParsedServices.Count == 0) { continue; }
                <tr class="quote-row" data-id="@record.RequestId" style="cursor: pointer;">
                    <td class="text-center toggle-btn"><span class="toggle-icon">&#x25BA;</span></td>
                    <td>@record.RequestId</td>
                    <td style="white-space: nowrap;">@(record.RequestDate.HasValue ? record.RequestDate.Value.ToString("MM/dd/yyyy HH:mm") : "")</td>
                    <td>@record.UserName</td>
                    <td>@record.Address</td>
                    <td>@record.City</td>
                    <td>@record.State</td>
                    <td>@record.Zip</td>
                    <td>@record.Country</td>
                    <td>@record.ParsedServices.Count</td>
                    <td>
                        @if (compareIds.Contains(record.RequestId))
                        {
                            <a href="@Url.Action("Compare", "Reports", new { id = record.RequestId })" class="btn btn-sm btn-outline-primary compare-link">Compare</a>
                        }
                    </td>
                </tr>
                <tr class="detail-row" id="detail-@record.RequestId" style="display: none;">
                    <td colspan="11">
                        <div class="row" style="margin: 0;">
                            <div class="col-md-4" style="border-right: 1px solid #dee2e6; padding: 8px 12px;">
                                <strong>Request</strong>
                                @if (!string.IsNullOrEmpty(record.ParsedRequest.ParseError))
                                {
                                    <div class="text-danger" style="font-size:0.85em;">Parse error: @record.ParsedRequest.ParseError</div>
                                }
                                else
                                {
                                    <table class="table table-sm table-borderless" style="margin: 4px 0 0 0; font-size: 0.9em;">
                                        <tbody>
                                            <tr>
                                                <td class="text-muted" style="white-space:nowrap; width:1%; padding: 2px 8px 2px 0;">Ship From</td>
                                                <td style="padding: 2px 0;">@record.ParsedRequest.ShipFromName &mdash; @record.ParsedRequest.ShipFromCity, @record.ParsedRequest.ShipFromState</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted" style="white-space:nowrap; padding: 2px 8px 2px 0;">Ship To</td>
                                                <td style="padding: 2px 0;">@record.ParsedRequest.ShipToCity, @record.ParsedRequest.ShipToState @record.ParsedRequest.ShipToZip (@record.ParsedRequest.ShipToCountry)</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted" style="white-space:nowrap; padding: 2px 8px 2px 0;">Pieces</td>
                                                <td style="padding: 2px 0;">@record.ParsedRequest.NumOfPieces</td>
                                            </tr>
                                            <tr>
                                                <td class="text-muted" style="white-space:nowrap; padding: 2px 8px 2px 0;">Weights (lbs)</td>
                                                <td style="padding: 2px 0;">@string.Join(", ", record.ParsedRequest.PackageWeights)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    if (!string.IsNullOrEmpty(record.ParsedRequest.ShipFromPlantId))
                                    {
                                        var _firstWeight = record.ParsedRequest.PackageWeights.FirstOrDefault();
                                        var _lastWeight = record.ParsedRequest.PackageWeights.Count > 1
                                            ? record.ParsedRequest.PackageWeights.Last()
                                            : null;
                                        if (_lastWeight == _firstWeight) { _lastWeight = null; }
                                        int _packages;
                                        int.TryParse(record.ParsedRequest.NumOfPieces, out _packages);
                                        <a href="@Url.Action("Index", "Plant", new {
                                                loc        = record.ParsedRequest.ShipFromPlantId,
                                                address    = record.Address,
                                                city       = record.City,
                                                state      = record.State,
                                                zip        = record.Zip,
                                                packages   = _packages,
                                                weight     = _firstWeight,
                                                lastWeight = _lastWeight,
                                                includeLtl = (record.ParsedServices.Count > 1)
                                            })"
                                           class="btn btn-sm btn-outline-primary" style="margin-top: 8px;" target="_blank">
                                            &#x21BA; Re-run from @record.ParsedRequest.ShipFromPlantId
                                        </a>
                                    }
                                }
                            </div>
                            <div class="col-md-8" style="padding: 8px 12px;">
                                <strong>Response</strong>
                                @if (!string.IsNullOrEmpty(record.ParseError))
                                {
                                    <div class="text-danger" style="font-size:0.85em;">Parse error: @record.ParseError</div>
                                }
                                else if (record.ParsedServices.Count > 0)
                                {
                                    <table class="table table-sm table-bordered services-table" style="margin: 4px 0 0 0;">
                                        <thead>
                                            <tr>
                                                <th>Service</th>
                                                <th>Code</th>
                                                <th>Published Rate</th>
                                                <th>Negotiated Rate</th>
                                                <th>Transit Days</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var svc in record.ParsedServices)
                                            {
                                                <tr>
                                                    <td>@svc.ServiceName</td>
                                                    <td>@svc.ServiceCode</td>
                                                    <td>@(string.IsNullOrEmpty(svc.PublishedRate) ? "-" : "$" + svc.PublishedRate)</td>
                                                    <td>@(string.IsNullOrEmpty(svc.NegotiatedRate) ? "-" : "$" + svc.NegotiatedRate)</td>
                                                    <td>@svc.TransitDays</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="text-muted" style="margin-top: 4px;">No rate data available for this record.</div>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @if (page > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Quotes", "Reports", new { page = page - 1, pageSize = pageSize, search = searchTerm, plant = selectedPlant })">&laquo; Prev</a>
                    </li>
                }
                @for (int i = Math.Max(1, page - 4); i <= Math.Min(totalPages, page + 4); i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Quotes", "Reports", new { page = i, pageSize = pageSize, search = searchTerm, plant = selectedPlant })">@i</a>
                    </li>
                }
                @if (page < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Quotes", "Reports", new { page = page + 1, pageSize = pageSize, search = searchTerm, plant = selectedPlant })">Next &raquo;</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section scripts {
    <script>
        function showQuotesLoading() {
            $('#quotes-loading').show();
            $('.quotes-table, .pagination').css({ opacity: 0.5, pointerEvents: 'none' });
        }

        // Undo the loading state when the browser restores this page from its back/forward cache.
        $(window).on('pageshow', function () {
            $('#quotes-loading').hide();
            $('.quotes-table, .pagination').css({ opacity: '', pointerEvents: '' });
        });

        $(document).ready(function () {
            $('#plant-filter').on('change', function () {
                showQuotesLoading();
                this.form.submit();
            });
            $('.quotes-form').on('submit', showQuotesLoading);
            $('.pagination .page-link').on('click', showQuotesLoading);

            // Compare opens its own page; don't also toggle the row's detail.
            $('.compare-link').on('click', function (e) { e.stopPropagation(); });

            $('.quote-row').on('click', function () {
                var id = $(this).data('id');
                var detailRow = $('#detail-' + id);
                var icon = $(this).find('.toggle-icon');
                if (detailRow.is(':visible')) {
                    detailRow.hide();
                    icon.html('&#x25BA;');
                } else {
                    detailRow.show();
                    icon.html('&#x25BC;');
                }
            });
        });
    </script>
}
